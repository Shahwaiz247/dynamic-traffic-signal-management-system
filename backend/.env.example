# DTSMS settings. Copy to backend/.env and fill in only what you need; every value below is the
# default the code already uses, so the app runs without a .env file.

# MySQL (optional): used when a server answers with this login, otherwise the built-in SQLite store
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=traffic_management

# HDFS (required): the single-node HDFS in WSL2 Ubuntu that install.ps1 sets up
HADOOP_NAMENODE_URL=http://127.0.0.1:9870
HADOOP_HDFS_PREFIX=/traffic/input
HADOOP_USER=hdfs

# Web server
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# Simulate a week of surveys when the database is empty (first start)
DTSMS_AUTO_SIMULATE=true

# Optional keys (the app works without them)
MAPBOX_ACCESS_TOKEN=
TOMTOM_API_KEY=
